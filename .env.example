# ==============================================
# VARIABLES D'ENVIRONNEMENT - Stack Jellyfin
# ==============================================
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir TOUTES les valeurs
#   3. Ne jamais committer le fichier .env
# ==============================================

# ==============================================
# TRAEFIK - DNS Provider pour certificats SSL
# ==============================================
# Infomaniak : https://manager.infomaniak.com/v3/ng/profile/api/dashboard
INFOMANIAK_ACCESS_TOKEN=votre_token_infomaniak_ici

# Cloudflare (alternative - décommenter si besoin)
# CF_API_EMAIL=votre-email@exemple.com
# CF_API_KEY=votre_api_key_cloudflare

# OVH (alternative - décommenter si besoin)
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# ==============================================
# GLUETUN - VPN WireGuard (vers VPS)
# ==============================================
# Générer une nouvelle paire de clés :
#   wg genkey | tee privatekey | wg pubkey > publickey
#   cat privatekey   → WIREGUARD_PRIVATE_KEY
#   cat publickey    → WIREGUARD_PUBLIC_KEY (à mettre aussi sur le VPS)
#
# Puis mettre à jour /etc/wireguard/wg0.conf sur le VPS
# avec la nouvelle public key du peer.
WIREGUARD_PRIVATE_KEY=votre_private_key_wireguard_base64
WIREGUARD_PUBLIC_KEY=cle_publique_du_vps_base64
WIREGUARD_ENDPOINT_IP=ip_de_votre_vps
WIREGUARD_ENDPOINT_PORT=51820

# ==============================================
# YGEGE - YGGTorrent Indexer
# ==============================================
# Compte 1 : Utilisé par ygege (sort via IP Freebox)
YGG_USERNAME_1=votre_username_ygg_1
YGG_PASSWORD_1=votre_password_ygg_1

# Compte 2 : Utilisé par ygege-vpn (sort via IP VPS/Gluetun)
YGG_USERNAME_2=votre_username_ygg_2
YGG_PASSWORD_2=votre_password_ygg_2

# ==============================================
# HOMEPAGE - Dashboard API Keys
# ==============================================
# Ces clés sont générées automatiquement par chaque service
# au premier démarrage. Les récupérer dans :
#   - Jellyfin   : Dashboard > API Keys
#   - Jellyseerr : Settings > General > API Key
#   - Sonarr     : Settings > General > API Key
#   - Radarr     : Settings > General > API Key
#   - Prowlarr   : Settings > General > API Key
#   - Bazarr     : Settings > General > API Key
#   - qBittorrent: Tools > Web UI > Authentication
HOMEPAGE_VAR_JELLYFIN_API=votre_api_key_jellyfin
HOMEPAGE_VAR_JELLYSEERR_API=votre_api_key_jellyseerr
HOMEPAGE_VAR_SONARR_API=votre_api_key_sonarr
HOMEPAGE_VAR_RADARR_API=votre_api_key_radarr
HOMEPAGE_VAR_PROWLARR_API=votre_api_key_prowlarr
HOMEPAGE_VAR_BAZARR_API=votre_api_key_bazarr
HOMEPAGE_VAR_QB_USER=votre_username_qbittorrent
HOMEPAGE_VAR_QB_PASS=votre_password_qbittorrent
